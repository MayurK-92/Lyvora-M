{
  "name": "Lyvora",
  "short_name": "Lyvora",
  "description": "Everything worth remembering, remembered.",
  "start_url": "/home",
  "scope": "/",
  "display": "standalone",
  "background_color": "#fbf8fc",
  "theme_color": "#fbf8fc",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "file",
          "accept": ["image/*", "application/pdf"]
        }
      ]
    }
  }
}
