# Copy to apps/web/.env.local

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role + DB URL are for Inngest pipeline workers only (never expose to the client).
# Settings → API → service_role | Settings → Database → URI (use the session/pooler URI).
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# --- Google Gemini (free key from https://aistudio.google.com/apikey) ---
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Inngest ---
# Local: set INNGEST_DEV=1 and run `pnpm inngest:dev` alongside `pnpm dev`.
INNGEST_DEV=1
# Cloud keys (only needed when deploying to Inngest Cloud):
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Optional: weekly report email (Resend) ---
# Reports still generate in /report without these. Email is skipped if unset.
RESEND_API_KEY=
RESEND_FROM=
NEXT_PUBLIC_APP_URL=http://localhost:3000
